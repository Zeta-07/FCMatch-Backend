{
  "name": "fcmatch-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node --env-file=.env dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --env-file=.env --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test tests/integration/*.test.ts",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "infra:mail": "node --import tsx scripts/mail-local.ts",
    "infra:check": "node --env-file=.env --import tsx scripts/check-connections.ts",
    "api:lint": "redocly lint docs/openapi.yaml",
    "api:generate": "openapi-ts -i ./docs/openapi.yaml -o src/shared/api -p @hey-api/typescript",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run api:lint && npm test && npm run test:integration && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@redocly/cli": "^2.75.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.10",
    "smtp-server": "^3.21.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "glob": "14.0.3",
    "js-yaml": "5.5.0"
  }
}
